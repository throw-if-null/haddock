#!/usr/bin/env bash
# Verify that the test suite detects a broken checker rule.
#
# Each mutant is a copy of the checker with one rule broken:
#
#   - one alternative removed from one PATTERNS regex, for every alternative;
#   - one behavior in BEHAVIOR_MUTANTS changed.
#
# tests/run MUST fail for every mutant. A mutant that passes is a rule without a test.
#
# The script writes every mutant to its own directory first, then runs the suite for all
# of them in parallel, then reports the verdicts in order. MUTATE_JOBS sets the number of
# parallel runs. The default is the number of processors.
#
# Exit status: 0 every mutant detected, 1 at least one mutant not detected, 2 tests/run
# fails on the unmodified checker.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
check="$root/skills/doc-style/scripts/check"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
jobs="${MUTATE_JOBS:-$(nproc)}"

# Each entry is a name, a tab, and one sed expression applied to the checker.
BEHAVIOR_MUTANTS=(
	"front matter not removed	/NR == 1 \&\& \/^---/d"
	"fenced code not removed	/fence = substr(\$0, RSTART, RLENGTH)/d"
	"~~~ fence not recognized	s/|~~~+)/)/g"
	"closing fence shorter than the opening fence accepted	s/>= length(fence)/>= 3/"
	"closing fence with an info string accepted	s/+)\[\[:space:\]\]\*\$\/) {/+)\/) {/"
	"indented code not removed	/indented = 1/d"
	"indented line without a blank line before is code	s/after_blank && //"
	"single-line HTML comment not removed	s/text = substr(text, 1, i - 1) \" \" substr(rest, j + 3)/break/"
	"multi-line HTML comment not removed	s/comment = 1\$/comment = 0/"
	"inline code not removed	/gsub(\/\`\[^\`\]\*\`\/, \"CODE\", text)/d"
	"source code read as Markdown	s/^\tmode=comments\$/\tmode=markdown/"
	"--comments ignored	s/((COMMENTS == 0)) \&\& //"
	".markdown not read as Markdown	s/ || \"\$file\" == \*.markdown//"
	"code line kept in source code	s/out = \"\"\$/out = \$0/"
	"// comment not read	s/(\/\/+|#+/(#+/"
	"# comment not read	s/|#+|/|/"
	"-- comment not read	s/|--+|/|/"
	"; comment not read	s/|;+)/)/"
	"/* */ block not read	/kind = \"\*\/\" }/d"
	"\"\"\" block not read	/kind = quotes/d"
	"/* inside a word opens a block	s/if (off + j == 1 || substr(line, off + j - 1, 1) ~ \/\[\[:space:\]\]\/) {/if (1) {/"
	"leading * in a block comment kept	/if (block == \"\*\/\") sub/d"
	"comment marker kept	s/out = substr(line, RSTART + RLENGTH)/out = line/"
	"inline code in a comment not removed	/gsub(\/\`\[^\`\]\*\`\/, \"CODE\", out)/d"
	"task marker line reports tone	/\[ -n \"\${task\[\$2\]:-}\" \] \&\& return 0/d"
	"trailing ? reported in source code	/\[\[ \"\$3\" =~/d"
	"source code exemptions apply to Markdown	s/if \[ \"\$mode\" = comments \] \&\& \[ \"\$1\" = tone \]/if [ \"\$1\" = tone ]/"
	"hyphen does not join a compound	s/^\tjoined=.*/\tjoined=\"\$stripped\"/"
	"match shows _ in place of -	/match=\"\${match\/\/_\/-}\"/d"
	"sentence cut ignores closing emphasis	s/\[\.!?:\]\[\*\`\")\\\\\]\]\*/[.!?:]/"
	"list marker does not start a paragraph	/\[0-9\]+\[\.)\]/s|/^|/^NEVER|"
	"surrounding whitespace counted as a word	/gsub(\/^\[\[:space:\]\]+|\[\[:space:\]\]+\$\/, \"\", parts\[i\])/d"
	"list marker counted as a word	/sub(\/^\[\[:space:\]\]\*(\[-\*+\]|\[0-9\]+\[\.)\])\[\[:space:\]\]+\/, \"\", text)/d"
	"length reports the paragraph line	s/file, start\[i\], count/file, start[1], count/"
	"cut marker can occur in text	s/\\\\001/@@CUT@@/g"
	"trailing whitespace ends a sentence on its own line	/sub(\/\[\[:space:\]\]+\$\/, \"\", text)/d"
	"heading, table, blockquote join a paragraph	/^\t*\/\^\[\[:space:\]\]\*\[#|>\]\/ { flush(); next }$/d"
	"tone question includes heading, table, blockquote	s/\^\[\^#|>\]\.\*/^.*/"
	"default limit 26	s/^MAX_WORDS=25$/MAX_WORDS=26/"
	"default limit 24	s/^MAX_WORDS=25$/MAX_WORDS=24/"
	"limit is inclusive	s/count > limit/count >= limit/"
	"--max-words ignored	s/MAX_WORDS=\"\${2:-}\"/MAX_WORDS=\"\$MAX_WORDS\"/"
	"findings exit 0	/if ((found)); then/{n;s/exit 1/exit 0/}"
	"file error exit 1	/if ((failed)); then/{n;s/exit 2/exit 1/}"
	"usage error exit 1	/^usage() {/,/^}/s/exit 2/exit 1/"
	"disable comment ignored	s/off\[r\] = 1$/delete off[r]/"
	"enable comment ignored	s/else delete off\[r\]/else off[r] = 1/"
	"directive without rule ID applies to no rule	/if (n == 1) for (r in known) ids\[r\] = 1/d"
	"all in a directive not accepted	s/if (word\[i\] == \"all\")/if (word[i] == \"ALL\")/"
	"unknown rule in a directive accepted	/unknown rule: %s/d"
	"unknown directive accepted	/unknown directive: %s/d"
	"directive without --> accepted	/directive does not end with -->/d"
	"directive line not blanked	\|sed -E \"s/\${DIRECTIVE}|d"
	"pattern findings not suppressed	/suppressed \"\$label\" \"\$line\" \&\& continue/d"
	"length findings not suppressed	s/suppressed length \"\${line%%:\\*}\" || //"
	".doc-style not used	s/if config=\"\$(find_config \"\$file\")\"; then/if false; then/"
	".doc-style search does not stop at the git root	/\[ -e \"\$dir\/.git\" \] \&\& return 1/d"
	".git file does not mark the git root	s/\[ -e \"\$dir\/.git\" \]/[ -d \"\$dir\/.git\" ]/"
	".doc-style pattern ignored	s/\[\[ \"\$rel\" == \$pattern \]\] \&\& matched=1/matched=1/"
	"path matched as given, not relative to .doc-style	/rel=\"\$(cd \"\$(dirname/s/.*/\trel=\"\$file\"/"
	"all in .doc-style not expanded	s/out+=\" \${RULES\[\*\]}\"/out+=\" all\"/"
	"unknown rule in .doc-style accepted	s/if ! is_rule \"\$rule\"; then/if false; then/"
	"pattern without a rule in .doc-style accepted	s/if ((\${#ids\[@\]} == 0)); then/if false; then/"
	"comment line in .doc-style not ignored	/\[\[ \"\${ids\[0\]}\" == \"#\"\* \]\] \&\& continue/d"
	"blank line in .doc-style not ignored	/((\${#ids\[@\]})) || continue/d"
	"allowlist ignored	/allowed \"\$match\" \&\& continue/d"
	"allowlist matches substrings	s/\[ \"\$word\" = \"\${1,,}\" \]/[[ \"\${1,,}\" == *\"\$word\"* ]]/"
	"allowlist case-sensitive	s/\${1,,}/\$1/;s/\${ids\[\*\],,}/\${ids[*]}/"
	"allow without a word accepted	s/if ((\${#ids\[@\]})); then/if true; then/"
)

# List every top-level alternative of every PATTERNS regex as LABEL<TAB>INDEX<TAB>TEXT,
# or, with -v label= -v drop=, print the checker with that one alternative removed.
# A "|" inside parentheses or a bracket expression is not a top-level separator.
# shellcheck disable=SC2016 # An awk program. Its $ fields belong to awk, not to the shell.
patterns_awk='
	function split_alts(re, alts,  i, c, depth, bracket, n, cur) {
		n = 0; depth = 0; bracket = 0; cur = ""
		for (i = 1; i <= length(re); i++) {
			c = substr(re, i, 1)
			if (bracket) {
				if (substr(re, i, 2) == "[:") {
					cur = cur substr(re, i, index(substr(re, i), ":]") + 1)
					i += index(substr(re, i), ":]")
					continue
				}
				if (c == "]") bracket = 0
			} else if (c == "[") {
				bracket = 1
			} else if (c == "(") {
				depth++
			} else if (c == ")") {
				depth--
			} else if (c == "|" && depth == 0) {
				alts[++n] = cur; cur = ""; continue
			}
			cur = cur c
		}
		alts[++n] = cur
		return n
	}
	/^\t"[a-z]+\t.*"$/ {
		line = substr($0, 3, length($0) - 3)
		tab = index(line, "\t")
		lab = substr(line, 1, tab - 1)
		n = split_alts(substr(line, tab + 1), alts)
		if (drop == "") {
			for (i = 1; i <= n; i++) printf "%s\t%d\t%s\n", lab, i, alts[i]
			next
		}
		if (lab == label) {
			out = ""
			for (i = 1; i <= n; i++) if (i != drop) out = out (out == "" ? "" : "|") alts[i]
			printf "\t\"%s\t%s\"\n", lab, out
			next
		}
	}
	drop != "" { print }
'

# A suite that already fails, or that cannot run, fails for every mutant. Each mutant
# then counts as detected although no test detected it.
if ! "$root/tests/run" >/dev/null 2>&1; then
	echo "tests/run fails on the unmodified checker. Run it and fix the failure first." >&2
	exit 2
fi

# Each mutant gets a numbered directory that holds its name, its checker, and later its
# verdict. add_mutant NAME moves the checker in $stage into the next directory and sets
# dir to it. A mutant that is identical to the checker gets its verdict here and does
# not run.
stage="$work/stage"
count=0
dir=""
add_mutant() {
	count=$((count + 1))
	dir="$work/$(printf '%04d' "$count")"
	mkdir "$dir"
	printf '%s\n' "$1" >"$dir/name"
	mv "$stage" "$dir/check"
	chmod +x "$dir/check"
	if cmp -s "$check" "$dir/check"; then
		echo "NOT APPLIED" >"$dir/verdict"
	fi
}

# A regex that grep rejects after the removal is a mutant that cannot run.
while IFS=$'\t' read -r label index text; do
	awk -v label="$label" -v drop="$index" "$patterns_awk" "$check" >"$stage"
	add_mutant "[$label] without $text"
	regex="$(grep -P "^\t\"$label\t" "$dir/check" | cut -f2 | sed 's/"$//')"
	status=0
	grep -E -i -- "$regex" /dev/null || status=$?
	if ((status == 2)); then
		echo "INVALID: $regex" >"$dir/verdict"
	fi
done < <(awk -v drop= "$patterns_awk" "$check")

for entry in "${BEHAVIOR_MUTANTS[@]}"; do
	sed -e "${entry#*	}" "$check" >"$stage"
	add_mutant "${entry%%	*}"
done

# Run the suite for every mutant without a verdict. Each run has its own checker and
# its own bats temporary directory, so the runs do not interfere.
# shellcheck disable=SC2016 # The variables belong to the inner shell.
find "$work" -mindepth 1 -maxdepth 1 -type d '!' -exec test -e '{}/verdict' ';' -print0 |
	xargs -0 -P "$jobs" -I '{}' bash -c '
		if CHECK="$1/check" "$2" >/dev/null 2>&1; then
			echo "NOT DETECTED" >"$1/verdict"
		else
			echo "DETECTED" >"$1/verdict"
		fi
	' _ '{}' "$root/tests/run"

detected=0
undetected=0
for dir in "$work"/*/; do
	verdict="$(cat "$dir/verdict")"
	if [ "$verdict" = DETECTED ]; then
		detected=$((detected + 1))
		continue
	fi
	undetected=$((undetected + 1))
	echo "$verdict: $(cat "$dir/name")"
done

echo "$detected detected, $undetected not detected"
((undetected == 0))
