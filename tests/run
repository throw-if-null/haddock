#!/usr/bin/env bash
# Run the test suite with bats-core. Arguments are passed to bats, for example
# --filter idiom.
#
# CHECK selects the checker under test. The default is the checker in this repository.
#
# Exit status: 0 all tests pass, 1 at least one test fails, 2 bats is not installed.
set -euo pipefail

tests="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v bats >/dev/null; then
	echo "bats not found. Run mise install, or install bats-core 1.7.0 or later." >&2
	exit 2
fi

exec bats "$@" "$tests"
