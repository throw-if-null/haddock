#!/usr/bin/env bash
# PostToolUse hook: run the doc-style checker on the Markdown file Claude Code edited.
#
# Claude Code sends the hook event as JSON on stdin. Edit and Write give the file in
# tool_input.file_path. When the file is Markdown, the script runs the checker on it from
# the directory in cwd, so that a .doc-style file applies as it does on the command line.
# When the checker reports candidates, the script prints one JSON object:
# additionalContext carries the report to Claude, and systemMessage shows it to the user.
# When the checker reports nothing, the script prints nothing.
#
# The exit status is always 0. PostToolUse cannot undo an edit, and a candidate is not an
# error. A problem in the hook itself goes to stderr, which Claude Code keeps in its debug
# log.
#
# The checker is ../skills/doc-style/scripts/check, relative to this script. DOC_STYLE_CHECK
# overrides that path. The script requires jq.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
check="${DOC_STYLE_CHECK:-$here/../skills/doc-style/scripts/check}"

input="$(cat)"

if ! jq -e . >/dev/null 2>&1 <<<"$input"; then
	echo "check-markdown: stdin is not JSON" >&2
	exit 0
fi

cwd="$(jq -r '.cwd // ""' <<<"$input")"
[ -n "$cwd" ] || cwd="$PWD"

path="$(jq -r '.tool_input.file_path // ""' <<<"$input")"
[ -n "$path" ] || exit 0
[[ "${path,,}" == *.md || "${path,,}" == *.markdown ]] || exit 0

# A relative path stays relative. The checker runs from cwd, so the report shows the path
# as Claude wrote it.
if [[ "$path" == /* ]]; then
	[ -f "$path" ] || exit 0
else
	[ -f "$cwd/$path" ] || exit 0
fi

status=0
report="$(cd "$cwd" && "$check" "$path" 2>&1)" || status=$?

case "$status" in
0) exit 0 ;;
1) ;;
*) report="doc-style checker failed (exit $status):"$'\n'"$report" ;;
esac

jq -n --arg report "$report" '{
	hookSpecificOutput: { hookEventName: "PostToolUse", additionalContext: $report },
	systemMessage: $report
}'
