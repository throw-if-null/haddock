{
  "description": "Run the doc-style checker on each Markdown file after Codex edits it.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/haddock/hooks/check-markdown\"",
            "timeout": 30,
            "statusMessage": "Checking documentation style"
          }
        ]
      }
    ]
  }
}
