{
  "description": "Run the doc-style checker on a Markdown file after Claude Code edits it.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/check-markdown",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
