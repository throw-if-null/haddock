#!/usr/bin/env bash
# Report constructions that the doc-style rules in ../rules.md exclude.
#
# Every hit is a candidate, not a verdict. Read each one and either rewrite it or keep it
# and state the reason. The script cannot judge context, and it cannot detect inconsistent
# terminology, duplicated explanations, or a description written as a requirement.
#
# YAML front matter, fenced and indented code blocks, HTML comments other than suppression
# directives, and inline code spans are removed before matching, so identifiers and
# commands do not produce hits. Line numbers refer to the original file.
#
# The patterns assume Markdown. Running it on a source file also reports the file's own
# syntax, so on a source file judge the hits inside comments and ignore the rest.
#
# A rule ID is a label that the script prints, for example tone or length. Two mechanisms
# suppress hits, and ../SKILL.md describes both:
#
#   - A line that holds only <!-- doc-style-disable RULE... --> suppresses the listed rules
#     until a line that holds only <!-- doc-style-enable RULE... -->, or until the end of
#     the file. Without a rule ID, or with all, the comment applies to every rule.
#   - The nearest .doc-style file, searched from the directory of the checked file up to
#     the root of its git repository, holds lines of the form PATTERN RULE... A file whose
#     path relative to the .doc-style file matches PATTERN is not checked for those rules.
#     A line of the form allow WORD... applies to every file that the .doc-style file
#     covers. No pattern rule reports a match whose whole text is WORD, ignoring case.
#
#   check docs/secrets.md README.md
#   check --max-words 30 docs/architecture.md
#
# Exit status: 0 no candidates, 1 candidates reported, 2 usage error, missing file, or
# invalid suppression. A file with an error is reported and the remaining files are still
# scanned.
set -euo pipefail

err() { echo "$*" >&2; }

MAX_WORDS=25

usage() {
	err "usage: ${0##*/} [--max-words N] FILE..."
	exit 2
}

# Each entry is a label, a tab, and one case-insensitive extended regular expression.
PATTERNS=(
	"idiom	\bload.bearing\b|\bbelt and braces\b|\bhas teeth\b|\bnot decoration\b|\blearned the hard way\b|\bthat (is|was) the point\b|\bthat's the point\b|\bblast radius\b|\bunder the hood\b|\bout of the box\b|\bsilver bullets?\b|\blow.hanging fruit\b|\brabbit holes?\b|\bfirst.class citizens?\b|\bheavy lifting\b|\bbattle.tested\b|\bbulletproof\b|\bmoving parts\b|\bat the end of the day\b|\bin the wild\b|\bboils down to\b|\bthe trick is\b|\brule of thumb\b|\bbells and whistles\b|\bfootguns?\b|\bgotchas?\b|\bhappy paths?\b|\bglue code\b|\bsanity checks?\b|\bmagic\b|\bhand.wav|\bdeep dives?\b|\bbaked in\b|\btable stakes\b|\bpaper over\b|\bband.aids?\b|\bmove the needle\b|\bnail down\b|\bswiss army\b|\bapples to apples\b|\bthe name of the game\b"
	"qualifier	\bjust\b|\bsimply\b|\bbasically\b|\bobviously\b|\bof course\b|\bactually\b|\bfairly\b|\bquite\b|\bpretty much\b|\ba bit\b|\bsomewhat\b|\bvery\b|\breally\b|\bmore or less\b|\bnicely\b|\beasily\b|\bworth (doing|knowing|the)\b|\bideally\b|\bhopefully\b|\bprobably\b|\bmostly\b|\bvarious\b|\bin general\b|\bgenerally speaking\b|\bsimple enough\b"
	"filler	\bnote that\b|\bworth noting\b|\bkeep in mind\b|\bbear in mind\b|\bas you can see\b|\blet's\b|\blet us\b|\bwe'll\b|\bwe will now\b|\byou'll want\b|\bfeel free\b|\bdon't worry\b|\bremember that\b|\bplease note\b|\bthat said\b|\bto be honest\b|\bas mentioned (above|earlier)\b"
	"anthropomorphism	\btalks? to\b|\bknows about\b|\bis smart enough\b|\bmagically\b|\bdecides to\b|\bis happy\b|\bcomplains\b|\bcares about\b|\bis aware of\b|\bdoesn't like\b|\bwants to know\b"
	"hype	\bleverage|\butilize|\bseamless|\brobust\b|\bpowerful\b|\bcutting.edge\b|\bstate of the art\b|\bgame.chang|\bbest.in.class\b|\bblazing|\beffortless|\brich set of\b|\belegant\b|\bdelightful\b|\bcomprehensive\b"
	"tone	!\s*$|^[^#|>].*\?\s*$|\bcool\b|\bawesome\b|\bnice!"
	"chain	—|[[:space:]]--[[:space:]]|;[[:space:]]|, which\b"
)

# Every rule ID: the PATTERNS labels and length.
RULES=()
for entry in "${PATTERNS[@]}"; do
	RULES+=("${entry%%	*}")
done
RULES+=(length)

# A line that starts with this extended regular expression is a suppression directive.
DIRECTIVE='^[[:space:]]*<!--[[:space:]]*doc-style-'

# is_rule ID succeeds when ID is a rule ID or all.
is_rule() {
	[[ " ${RULES[*]} all " == *" $1 "* ]]
}

# Blank out front matter, code blocks, and HTML comments other than directives, and reduce
# every inline code span to CODE. The output has one line per input line, so that grep -n
# reports the original line numbers, and a code span still counts as one word.
#
# A fence is three or more backticks or tildes. Only a line that holds the same character
# at least as many times, and nothing else, closes it. An indented code block starts with
# four spaces or a tab after a blank line. It ends at a line that is not blank and not
# indented.
strip_code() {
	awk -v directive="$DIRECTIVE" '
		# emit TEXT prints TEXT with inline code spans reduced to CODE and HTML comments
		# removed. A comment without --> continues on the next line.
		function emit(text,  i, j, rest) {
			gsub(/`[^`]*`/, "CODE", text)
			while ((i = index(text, "<!--"))) {
				rest = substr(text, i + 4)
				if (!(j = index(rest, "-->"))) {
					text = substr(text, 1, i - 1)
					comment = 1
					break
				}
				text = substr(text, 1, i - 1) " " substr(rest, j + 3)
			}
			print text
		}
		BEGIN { blank = 1 }
		{ after_blank = blank; blank = /^[[:space:]]*$/ }
		NR == 1 && /^---[[:space:]]*$/ { front = 1; print ""; next }
		front { if (/^---[[:space:]]*$/) front = 0; print ""; next }
		fence != "" {
			if (/^[[:space:]]*(```+|~~~+)[[:space:]]*$/) {
				mark = $0
				gsub(/[[:space:]]/, "", mark)
				if (substr(mark, 1, 1) == substr(fence, 1, 1) && length(mark) >= length(fence)) fence = ""
			}
			print ""
			next
		}
		indented && (blank || /^(    |\t)/) { print ""; next }
		{ indented = 0 }
		comment {
			if (!(i = index($0, "-->"))) { print ""; next }
			comment = 0
			emit(substr($0, i + 3))
			next
		}
		match($0, /^[[:space:]]*(```+|~~~+)/) {
			fence = substr($0, RSTART, RLENGTH)
			gsub(/[[:space:]]/, "", fence)
			print ""
			next
		}
		after_blank && /^(    |\t)/ { indented = 1; print ""; next }
		$0 ~ directive { print; next }
		{ emit($0) }
	' "$1"
}

# Read the code-stripped text of FILE on stdin and report sentences longer than MAX_WORDS.
# Paragraphs are accumulated because a sentence spans several wrapped lines. The reported
# line is where the paragraph starts.
#
# A list marker starts a new paragraph. Without that rule a list of short items is
# accumulated into one buffer and reported as a single long sentence. A wrapped
# continuation line carries no marker, so it still joins the item above it.
long_sentences() {
	local file="$1"
	awk -v file="$file" -v limit="$MAX_WORDS" '
		function flush(  tmp, parts, words, n, i, count) {
			if (buf ~ /^[[:space:]]*$/) { buf = ""; return }
			tmp = buf
			# A terminator may carry closing emphasis, a backtick, a quote or a bracket
			# before the space. Cutting only on the bare terminator merges a bold lead-in
			# sentence with the sentence after it and reports the pair as one.
			gsub(/[.!?:][*`")\]]*[[:space:]]+/, "&@@CUT@@", tmp)
			n = split(tmp, parts, "@@CUT@@")
			for (i = 1; i <= n; i++) {
				# Leading or trailing whitespace makes split() return an empty field, which
				# is not a word.
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[i])
				count = split(parts[i], words, /[[:space:]]+/)
				if (count > limit)
					printf "%s:%d: [length] %d-word sentence: %.56s...\n", file, start, count, parts[i]
			}
			buf = ""
		}
		/^[[:space:]]*$/ { flush(); next }
		/^[[:space:]]*[#|>]/ { flush(); next }
		/^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]/ {
			flush()
			start = NR
			# The list marker is not a word of the sentence.
			buf = $0
			sub(/^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]+/, "", buf)
			next
		}
		{
			if (buf == "") start = NR
			buf = buf " " $0
		}
		END { flush() }
	'
}

# Read the code-stripped text of FILE on stdin and print LINE<TAB>RULE... for every line
# inside a disabled region. A directive outside a code block is the only content of its
# line. Errors go to stderr, and the exit status is then 1.
inline_regions() {
	awk -v file="$1" -v rules="${RULES[*]}" -v directive="$DIRECTIVE" '
		BEGIN { n = split(rules, list, " "); for (i = 1; i <= n; i++) known[list[i]] = 1 }
		$0 ~ directive {
			text = $0
			if (!sub(/[[:space:]]*-->[[:space:]]*$/, "", text)) { printf "%s:%d: directive does not end with -->\n", file, NR > "/dev/stderr"; bad = 1; next }
			sub(/^[[:space:]]*<!--[[:space:]]*/, "", text)
			n = split(text, word, /[[:space:]]+/)
			if (word[1] != "doc-style-disable" && word[1] != "doc-style-enable") { printf "%s:%d: unknown directive: %s\n", file, NR, word[1] > "/dev/stderr"; bad = 1; next }
			split("", ids)
			if (n == 1) for (r in known) ids[r] = 1
			for (i = 2; i <= n; i++) {
				if (word[i] == "all") { for (r in known) ids[r] = 1; continue }
				if (!(word[i] in known)) { printf "%s:%d: unknown rule: %s\n", file, NR, word[i] > "/dev/stderr"; bad = 1; continue }
				ids[word[i]] = 1
			}
			for (r in ids) {
				if (word[1] == "doc-style-disable") off[r] = 1
				else delete off[r]
			}
			next
		}
		{
			set = ""
			for (r in off) set = set " " r
			if (set != "") printf "%d\t%s \n", NR, set
		}
		END { exit bad }
	'
}

# Print the .doc-style file that applies to FILE: the nearest one in the directory of FILE
# or above it. The search stops at the root of the git repository that holds FILE, so a
# file outside the repository does not change the result. A worktree or a submodule has a
# .git file, not a directory.
find_config() {
	local dir
	dir="$(cd "$(dirname "$1")" && pwd -P)"
	while :; do
		if [ -f "$dir/.doc-style" ]; then
			printf '%s\n' "$dir/.doc-style"
			return 0
		fi
		[ -e "$dir/.git" ] && return 1
		[ "$dir" = / ] && return 1
		dir="$(dirname "$dir")"
	done
}

# Print, separated by a tab, the rule IDs that CONFIG disables for FILE and the words that
# CONFIG allows, in lower case. A CONFIG line is a pattern and one or more rule IDs, or allow and
# one or more words. The pattern matches the path of FILE relative to the directory of
# CONFIG, and * also matches /. A line that starts with # is a comment. Errors go to
# stderr, and the status is then 2.
read_config() {
	local config="$1" file="$2" rel line pattern rule matched n=0 bad=0 out="" allow=""
	local -a ids
	rel="$(cd "$(dirname "$file")" && pwd -P)/${file##*/}"
	rel="${rel#"${config%/*}"/}"
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		read -r -a ids <<<"$line"
		((${#ids[@]})) || continue
		[[ "${ids[0]}" == "#"* ]] && continue
		pattern="${ids[0]}"
		ids=("${ids[@]:1}")
		if [ "$pattern" = allow ]; then
			if ((${#ids[@]})); then
				allow+=" ${ids[*],,}"
			else
				err "$config:$n: no word after allow"
				bad=1
			fi
			continue
		fi
		if ((${#ids[@]} == 0)); then
			err "$config:$n: no rule after pattern: $pattern"
			bad=1
			continue
		fi
		matched=0
		# shellcheck disable=SC2053 # The pattern is a glob.
		[[ "$rel" == $pattern ]] && matched=1
		for rule in "${ids[@]}"; do
			if ! is_rule "$rule"; then
				err "$config:$n: unknown rule: $rule"
				bad=1
			elif ((matched)) && [ "$rule" = all ]; then
				out+=" ${RULES[*]}"
			elif ((matched)); then
				out+=" $rule"
			fi
		done
	done <"$config"
	((bad == 0)) || return 2
	printf '%s\t%s\n' "$out" "$allow"
}

# suppressed RULE LINE succeeds when RULE is disabled at LINE, by the .doc-style file or by
# an inline directive. It reads config_off and line_off from the calling scan_file.
suppressed() {
	[[ " $config_off ${line_off[$2]:-} " == *" $1 "* ]]
}

# allowed MATCH succeeds when the whole text of MATCH, in lower case, is a word on an allow
# line of the .doc-style file. It reads allow from the calling scan_file.
allowed() {
	local word
	for word in "${allow[@]}"; do
		[ "$word" = "${1,,}" ] && return 0
	done
	return 1
}

scan_file() {
	local file="$1" stripped joined entry label regex hits line match snippet config settings config_off="" regions rules finding
	local -a src allow=()
	local -A line_off=()
	if [ ! -f "$file" ]; then
		err "no such file: $file"
		return 2
	fi
	if config="$(find_config "$file")"; then
		settings="$(read_config "$config" "$file")" || return 2
		config_off="${settings%%	*}"
		read -r -a allow <<<"${settings#*	}"
	fi
	mapfile -t src <"$file"
	stripped="$(strip_code "$file")"
	regions="$(inline_regions "$file" <<<"$stripped")" || return 2
	while IFS=$'\t' read -r line rules; do
		[ -n "$line" ] || continue
		line_off[$line]="$rules"
	done <<<"$regions"
	# A directive line matches no pattern and ends the paragraph before it.
	stripped="$(sed -E "s/${DIRECTIVE}.*//" <<<"$stripped")"
	# A hyphen between two letters or digits joins a compound word. The patterns match a
	# copy of the text in which each such hyphen is _, a word character, so that \b does
	# not match inside a compound: \bmagic\b does not match magic-free. A reported match
	# shows each _ as -.
	joined="$(sed -E -e ':a' -e 's/([[:alnum:]])-([[:alnum:]])/\1_\2/g' -e 'ta' <<<"$stripped")"
	{
		for entry in "${PATTERNS[@]}"; do
			label="${entry%%	*}"
			regex="${entry#*	}"
			hits="$(printf '%s\n' "$joined" | grep -n -i -o -E -- "$regex" || true)"
			[ -n "$hits" ] || continue
			while IFS=: read -r line match; do
				[ -n "$line" ] || continue
				match="${match//_/-}"
				snippet="${src[line - 1]}"
				allowed "$match" && continue
				suppressed "$label" "$line" && continue
				snippet="${snippet#"${snippet%%[![:space:]]*}"}"
				printf '%s:%s: [%s] %s | %.52s\n' "$file" "$line" "$label" "$match" "$snippet"
			done <<<"$hits"
		done
		long_sentences "$file" <<<"$stripped" | while IFS= read -r finding; do
			line="${finding#"$file":}"
			suppressed length "${line%%:*}" || printf '%s\n' "$finding"
		done
	} | sort -t: -k2,2n -s
}

FILES=()
while (($#)); do
	case "$1" in
	--max-words)
		MAX_WORDS="${2:-}"
		[[ "$MAX_WORDS" =~ ^[0-9]+$ ]] || usage
		shift 2
		;;
	-h | --help) usage ;;
	-*)
		err "unknown option: $1"
		usage
		;;
	*)
		FILES+=("$1")
		shift
		;;
	esac
done

((${#FILES[@]})) || usage

found=0
failed=0
for file in "${FILES[@]}"; do
	# scan_file returns 2 for a missing file or an invalid suppression. Capture the
	# status so that one bad file does not end the run under set -e.
	status=0
	output="$(scan_file "$file")" || status=$?
	if ((status)); then
		failed=1
		continue
	fi
	[ -n "$output" ] || continue
	printf '%s\n' "$output"
	found=1
done

if ((found)); then
	echo
	echo "Candidates reported. Rewrite each one, or keep it and state the reason."
fi

if ((failed)); then
	exit 2
fi

if ((found)); then
	exit 1
fi

exit 0
